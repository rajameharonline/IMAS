# এই ফাইলটি environment variable এর উদাহরণ। আসল .env ফাইলে সঠিক মান দিন।
# কখনো এই ফাইলে আসল credentials লিখবেন না।

# Django
SECRET_KEY=your-very-secret-django-key-change-this
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database
DB_NAME=radius
DB_USER=radius
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# FreeRADIUS PostgreSQL (একই DB)
RADIUS_DB_HOST=localhost
RADIUS_DB_PORT=5432
RADIUS_DB_NAME=radius
RADIUS_DB_USER=radius
RADIUS_DB_PASSWORD=your_radius_db_password

# Mikrotik Router (default - can be overridden per-router in DB)
MIKROTIK_HOST=192.168.1.1
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=your_router_password
MIKROTIK_PORT=8728

# SMS Gateway
SMS_GATEWAY_URL=https://your-sms-gateway.com/api/send
SMS_GATEWAY_API_KEY=your_sms_api_key
SMS_SENDER_ID=ISPNAME

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@yourisp.com

# Payment Gateway (bKash/Nagad/SSLCommerz)
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASS=your_store_pass
SSLCOMMERZ_IS_SANDBOX=True

# Company Info
COMPANY_NAME=Your ISP Name
COMPANY_ADDRESS=Your Company Address
COMPANY_PHONE=01XXXXXXXXX

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=django-db

# OLT SNMP
OLT_SNMP_COMMUNITY=public
OLT_SNMP_VERSION=2c

# Timezone
TIME_ZONE=Asia/Dhaka
